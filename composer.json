{
    "name": "dirthara/entity",
    "description": "Entities for the Dirthara framework",
    "type": "library",
    "require": {
        "php": "^8.5",
        "dirthara/collection": "^0.1",
        "dirthara/database": "^0.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.0"
    },
    "suggest": {
        "ext-pdo_mysql": "To map entities against the MySQL driver",
        "ext-pdo_pgsql": "To map entities against the PostgreSQL driver",
        "ext-pdo_sqlite": "To map entities against the SQLite driver",
        "ext-pdo_sqlsrv": "To map entities against the SQL Server driver"
    },
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Dirthara\\Entity\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Dirthara\\Entity\\Tests\\": "tests/"
        }
    },
    "authors": [
        {
            "name": "Dirthara"
        }
    ],
    "prefer-stable": true,
    "config": {
        "sort-packages": true
    },
    "scripts": {
        "mago": "sh scripts/mago.sh",
        "fmt": [
            "mago fmt",
            "@imports"
        ],
        "fmt-check": [
            "mago fmt --check",
            "@imports-check"
        ],
        "lint": "mago lint",
        "lint-fix": "mago lint --fix --potentially-unsafe",
        "analyze": "mago analyze",
        "guard": "mago guard",
        "test": "sh scripts/when-source-exists.sh phpunit",
        "test-coverage": "XDEBUG_MODE=coverage sh scripts/when-source-exists.sh phpunit --coverage-clover=build/coverage/clover.xml",
        "coverage": "sh scripts/when-source-exists.sh php scripts/coverage.php build/coverage/clover.xml 100",
        "cs": [
            "@lint-fix",
            "@fmt"
        ],
        "ci": [
            "@mago",
            "@test-tools",
            "@test-coverage",
            "@coverage"
        ],
        "imports": "@php scripts/sort-imports.php",
        "imports-check": "@php scripts/sort-imports.php --check",
        "test-tools": "@php scripts/tests/sort-imports.php"
    }
}
